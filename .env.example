# LLM 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL=doubao-seed-1-6-251015

# GitLab 配置
PRIVATE_TOKEN=your_gitlab_private_token_here

# SQLite Web 管理页密码（/add-work/sqlite/）
SQLITE_WEB_PASSWORD=change-me

# MCP 连接认证（自定义 Header：X-MCP-Token）
MCP_TOKEN=change-me

# 工时网页地址（MCP 引导未登录用户时使用）
ADD_WORK_URL=http://hn.frp.one:39032/add-work/

# 补丁：工时结果推送（plugins/addwork_patches/worklog_pusher）
# 企业微信机器人地址，不配置则不推送
WORKLOG_PUSH_ENABLED=false
WORKLOG_PUSH_WEBHOOK_URL=

# 补丁：周报提醒（plugins/addwork_patches/weekly_reminder）
REMINDER_ENABLED=false
REMINDER_WEBHOOK_URL=
